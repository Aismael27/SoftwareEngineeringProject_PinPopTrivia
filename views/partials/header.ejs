<header class="header">
    <h1> PinPop Trivia! </h1>
    <% if (user) { %>
        <a class="login-button" href="/logout">Logout</a>
    <% } else { %>
        <a class="login-button" href="/login">Login</a>
    <% } %>
</header>
<div class = "navbar"> 
    <a class = "navButton" href = "/">Home</a>
    <a class = "navButton" href = "/leaderboard">Leaderboard</a>
    <a class = "navButton" href = "/weeklyquiz">Weekly Quiz</a>
    <a class = "navButton" href = "/quiz">Quizzes</a>
    <a class = "navButton" href = "/freeplay">Freeplay</a>
    <a class = "navButton" href = "/suggest">Suggest</a>
    <% if (user && user.role === 'admin') { %>
        <a class = "navButton" href = "/adminDashboard">Admin</a>
    <% } else { %>
        <a class = "navButton" href = "/profile">Profile</a>
    <% } %>
</div>