<header class="header">
    <h1> PinPop Trivia! </h1>
    <% if (user) { %>
        <a class="login-button" href="/logout">Logout</a>
    <% } else { %>
        <a class="login-button" href="/login">Login</a>
    <% } %>
</header>
<div class = "navbar"> 
    <a class = "navButton" href = "/">Home</a>
    <a class = "navButton" href = "/leaderboard">Leaderboard</a>
    <a class = "navButton" href = "/quiz">Bite Sized Quiz</a>
    <div class="dropdown">
        <button class="dropbtn">Quiz by Region
            <i class="fa fa-caret-down"></i>
        </button>
        <div class="dropdown-content">
            <a href="/quiz/region/africa">Africa</a>
            <a href="/quiz/region/oceania">Oceania</a>
            <a href="/quiz/region/asia">Asia</a>
            <a href="/quiz/region/europe">Europe</a>
            <a href="/quiz/region/north-america">North America</a>
            <a href="/quiz/region/south-america">South America</a>
            <a href="/quiz/region/middle-east">Middle East</a>
        </div>
    </div>
    <div class="dropdown">
        <button class="dropbtn">Quiz by Media Type
            <i class="fa fa-caret-down"></i>
        </button>
        <div class="dropdown-content">
            <a href="/quiz/mediatype/movies">Movies</a>
            <a href="/quiz/mediatype/tv-shows">TV Shows</a>
            <a href="/quiz/mediatype/books">Books</a>
        </div>
    </div>
    <a class = "navButton" href = "/freeplay">Freeplay</a>
    <a class = "navButton" href = "/suggest">Suggest</a>
    <% if (user && user.role === 'admin') { %>
        <a class = "navButton" href = "/adminDashboard">Admin</a>
    <% } else { %>
        <a class = "navButton" href = "/profile">Profile</a>
    <% } %>
</div>