<!DOCTYPE html>
<html>
    <head>
        <title> Quizzes </title>
        <link rel="stylesheet" type="text/css" href="/css/style.css"/>
        <script src="/js/quizjs.js" defer></script>
        <link href="https://fonts.googleapis.com/css2?family=Special+Elite&display=swap" rel="stylesheet">
        <link href="https://fonts.googleapis.com/css2?family=Limelight&family=Special+Elite&display=swap" rel="stylesheet">
    </head>
    <body>
        <%- include('../partials/header.ejs') %>
        <br>
        <div id="timer-container" style="width:80%; margin: 10px auto;">
    <div id="timer-bar" style="height:18px; width:100%; background:#4caf50; border-radius:8px;"></div>
</div>
        <% if (mediatype == null && region == null) { %>
            <h1 class="bdyHead" style="font-size: 70px; text-align: center; margin-top: 30px;">Bite-sized Quiz!</h1>
        <% } else if (mediatype == null) { %>
            <h1 class="bdyHead" style="font-size: 70px; text-align: center; margin-top: 30px;"><%= region.charAt(0).toUpperCase() + region.slice(1) %> Quiz!</h1>
        <% } else { %>
            <h1 class="bdyHead" style="font-size: 70px; text-align: center; margin-top: 30px;"><%= mediatype.charAt(0).toUpperCase() + mediatype.slice(1) %> Quiz!</h1>
        <% } %>
        <div id="answer" style="display: none;"></div>
        <div id="mediatype" data-value="<%= mediatype %>"></div>
        <div id="region" data-value="<%= region %>"></div>
        <div id="isLoggedIn" data-value="<%= user ? 'true' : 'false' %>"></div>

        <div class="quiz_head" id = "head">
            <div>
                <img src="/css/images/Reel.png" alt="camera" width="75" height="60">
            </div>
            <div class="quiz_text" id="question"></div>
        </div>
        <div class="quiz_body" >
            <div class="quiz_answer" id="A" onclick="clicked(this, 'A')"></div>
        </div> 
        <div class="quiz_body" >
            <div class="quiz_answer" id="B" onclick="clicked(this, 'B')"></div>
        </div> 
        <div class="quiz_body" >
            <div class="quiz_answer" id="C" onclick="clicked(this, 'C')"></div>
        </div> 
        <div class="quiz_body" >
            <div class="quiz_answer"  id="D" onclick="clicked(this, 'D')"></div>
        </div> 
        <div class="next" id = "next">
            <div id="nextButton" onclick="next('s')"> Next </div>
        </div> 
        <div id="scorePopup" class="score-popup" style="display:none;">
            <div id="end"><b>Score:</b></div>
            <div id="score"></div>
            <div id="endQ"><b>Questions answered:</b></div>
            <div id="qc"></div>
            <br>
            <button onclick="window.location.href = '/';" style="background-color: #D1b585; color: black; font-size: large;">Home</button>
            <button onclick="window.location.href = '/quiz';" style="background-color: #D1b585; color: black; font-size: large;">Play again!</button>
        </div>
    
    <script>
        const mediatype = '<%= mediatype %>';
        const region = '<%= region %>';

        window.onload = function() {
            loadQuestion(mediatype, region);
        }
    </script>
    </body>
</html>