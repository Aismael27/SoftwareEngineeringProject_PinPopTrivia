<!DOCTYPE html>
<html>
    <head>
        <title>Leaderboard</title>
        <link rel="stylesheet" type="text/css" href="/css/style.css"/>
        <link href="https://fonts.googleapis.com/css2?family=Special+Elite&display=swap" rel="stylesheet">
        <link href="https://fonts.googleapis.com/css2?family=Limelight&family=Special+Elite&display=swap" rel="stylesheet">
    </head>
    <body>
        <%- include('../partials/header.ejs') %>
        <div class="twoColumns">
            <div class="smallCol"> <div class="contentBox">
                <h2 class="bdyHead">Bite-sized quiz</h2>
                <h2 class="bdyHead"><b>Leaderboard</b></h2>
                <table>
                    <thead>
                        <tr class="highlight">
                            <th>Rank</th>
                            <th>Username</th>
                            <th>Score</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% biteUsers.forEach((u, index) => { %>
                        <tr>
                            <td><%= index + 1 %></td>
                            <td><%= u.username %></td>
                            <td><%= u.bite_highscore %></td>
                        </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div></div>
            <div class="smallCol">  <div class="contentBox">
                <h2 class="bdyHead">Freeplay quiz</h2>
                <h2 class="bdyHead"><b>Leaderboard</b></h2>
                <table>
                    <thead>
                        <tr class="highlight">
                            <th>Rank</th>
                            <th>Username</th>
                            <th>Score</th>
                            <th>Streak</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% freeplayUsers.forEach((u, index) => { %>
                        <tr>
                            <td><%= index + 1 %></td>
                            <td><%= u.username %></td>
                            <td><%= u.freeplay_score %></td>
                            <td><%= u.freeplay_streak %></td>
                        </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div> </div>
        </div>
    </body>
</html>